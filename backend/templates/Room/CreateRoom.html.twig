{% extends 'base.html.twig' %}

{% block title %}Create Room{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="styles/login.css">
{% endblock %}

{% block body %}
<div>
     <form method="POST" action="{{ path('room_create') }}">
        <div>
            <label for="name">Название комнаты</label>
            <input type="text" id="name" name="name" required placeholder="Введите название">
        </div>

        <div>
            <label>Режим боя:</label>
            <div>
                <label>
                    <input type="radio" name="gamemode" value="deathmatch" checked>
                    Помеситься
                </label>
                <label>
                    <input type="radio" name="gamemode" value="team">
                    Гонка вооружений
                </label>
                <label>
                    <input type="radio" name="gamemode" value="capture">
                    Захват флага
                </label>
            </div>
        </div>

        <div>
            <label>
                <input type="checkbox" name="isOpen">
                Приватная комната
            </label>
        </div>

        <button type="submit">Создать комнату</button>
    </form>

    <a href="{{ path('main_page') }}">Назад</a>
</div>
{% endblock %}
