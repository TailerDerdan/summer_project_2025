{% extends 'base.html.twig' %}

{% block title %}Room{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="styles/login.css">
{% endblock %}

{% block body %}
    <div>
        <p>{{ room.name }}</p>
        <p>{{ room.gamemode }}</p>
        <p>{% if room.isOpen %}Открытая{% else %}Закрытая{% endif %}</p>
        <button type="submit">Выйти</button>
        <button type="submit">Играть</button>
    </div>
{% endblock %}
