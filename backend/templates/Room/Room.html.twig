{% extends 'base.html.twig' %}

{% block title %}Room{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="/styles/login.css">
{% endblock %}

{% block javascripts %}
    <script src="/scripts/joinRoom.js"></script>
{% endblock %}

{% block body %}
    <div>
        <p>{{ room.name }}</p>
        <p>{{ room.gamemode }}</p>
        <p>{% if room.isOpen %}Открытая{% else %}Закрытая{% endif %}</p>
        <div class="user-list"></div>
        <a href="{{ path('main_page') }}">Назад</a>
        <button class="leave-room-btn" type="submit">Выйти</button>
        <button type="submit">Играть</button>
    </div>
{% endblock %}
