{% extends 'base_room.html.twig' %}

{% block title %}Create Room{% endblock %}

{% block stylesheets %}
    <link href="/styles/room_lobby.css" rel="stylesheet" xmlns="http://www.w3.org/1999/html">
{% endblock %}

{% block javascripts %}
    <script src="/scripts/roomSettings.js"></script>
    <script src="/scripts/joinRoom.js"></script>
    <script src="/scripts/parameters_handler.js"></script>
{% endblock %}

{% block body %}
    <div class="room-window">
        <p class="room-window__header">{{ room.name }}</p>
        <div class="room-window__room-info">
            <div class="room-info__main">
                <div class="room-info__main-parameters-list">
                    <div class="room-info__main-parameters-list-item">
                        <p class="room-info__main-parameters-list-item-title">Режим игры:</p>
                        <p class="room-info__main-parameters-list-item-value" id="room-gamemode">{{ room.gamemode }}</p>
                    </div>
                    <div class="room-info__main-parameters-list-item">
                        <p class="room-info__main-parameters-list-item-title">Приватность:</p>
                        {% if room.isOpen %}
                            <p class="room-info__main-parameters-list-item-value">Открыто</p>
                        {% else %}
                            <p class="room-info__main-parameters-list-item-value">Закрыто</p>
                        {% endif %}
                    </div>
                </div>
                {% if user.userId == room.hostId %}
                <div class="create-room__parameters-room-list-item">
                    <label class="parameters-room-list-item__header-room-maps" for="room_map">Выберите карту</label>
                    <select class="room-maps-list" id="room_map" name="room_map" required>
                        {% for map in maps %}
                            <option class="room-maps-list-item" value="{{ map.name }}">{{ map.name }}</option>
                        {% endfor %}
                    </select>
                    <br><br>
                </div>
                {% endif %}
                <div class="timer-down" style="display: inline"></div>
                <div class="room-info__main-indicator-bar"></div>
            </div>
            <div class="room-info__decorations">
                <img src="/images/cool_man.png" alt="Здесь должна быть картинка с крутым чуваком">
            </div>
        </div>
        <div class="room-window__buttons">
            {% if user.userId == room.hostId %}
                <button class="room-window__button" id="room_start" type="button">Поехали!</button>
            {% endif %}
            <button class="room-window__button" id="leave-room-btn" type="button">Выйти из комнаты</button>
            <button value="not ready" type="button" class="room-window__button room-window__button-ready" id="room_ready-{{ user.userId }}">ГОТОВ</button>
        </div>
    </div>
{% endblock %}
