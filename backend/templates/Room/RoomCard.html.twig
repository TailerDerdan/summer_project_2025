{% extends 'base.html.twig' %}

{% block title %}Room{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="styles/login.css">
{% endblock %}

{% block body %}
    <div class="room">
        <span>${room.name}</span>
        <button onclick="joinRoom('${room.id}')">Join</button>
        <p>{% if room.isOpen "Открытая" else "Закрытая" endif %}</p>
    </div>
{% endblock %}
