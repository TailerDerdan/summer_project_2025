{% extends 'base_room.html.twig' %}

{% block title %}Меню{% endblock %}

{% block stylesheets %}
    <link href="/styles/room_menu.css" rel="stylesheet">
{% endblock %}

{% block javascripts %}
    <script src="/scripts/room_menu.js"></script>
    <script src="/scripts/parameters_handler.js"></script>
    <script src="/scripts/volume_controller.js"></script>
{% endblock %}

{% block body %}
    <div class="room-menu">
        <div class="room-menu__header">
            <p class="room-menu__header-text">Игровые комнаты</p>
            <a class="room-menu__create-room" href="{{ path('room_create_page') }}">Создать комнату</a>
        </div>
        <div class="room-menu__room-list">
            {% for room in rooms %}
                <div class="room-menu__room-list-item" onclick="joinRoom('{{ room.id }}')">
                    <div class="room-list-item__main">
                        <div class="room-list-item__header">
                            <p class="room-list-item__name">{{ room.name }}</p>
                            {% if not room.isOpen %}
                                <img class="room-list-item__status-indicator" src="public/images/lock.png" alt="">
                            {% endif %}
                        </div>
                        <div class="room-list-item__avatar-list">
{#                            {% for player in room.players %}#}
{#                                <img class="room-list-item__avatar-list-item" src="" alt="Аватар">#}
{#                            {% endfor %}#}
                        </div>
                    </div>
                    <div class="room-list-item__extra">
                        {% if room.playersCount < room.maxPlayers %}
                            <p class="room-list-item__fill-indicator">{{ room.playersCount }}/{{ room.maxPlayers }}</p>
                        {% else %}
                            <p class="room-list-item__fill-indicator-full">{{ room.maxPlayers }}/{{ room.maxPlayers }}</p>
                        {% endif %}
                        <p class="room-list-item__gamemode">{{ room.gamemode }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
