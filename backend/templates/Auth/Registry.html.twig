{% extends 'base.html.twig' %}

{% block title %}Регистрация{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="../styles/login.css">
{% endblock %}

{% block body %}
<div class="back">
    <h1 class="game-name">MOCHILOVO</h1>
    <form method="POST" action="{{ path('registry_Proc') }}" enctype="multipart/form-data" class="form-auth">
        <input type="text" name="nickName" required placeholder="NickName" class="form-auth__input">
        <input type="password" name="password" required placeholder="Password" class="form-auth__input">
        <input type="password" name="confirm_password" required placeholder="Confirm Password" class="form-auth__input">
        <button type="submit" class="form-auth__button-submit">Зарегаться</button>
        <a href="{{ path('login') }}" class="form-auth__href">Войти</a>
    </form>
</div>
{% endblock %}
