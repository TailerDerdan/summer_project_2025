{% extends 'base.html.twig' %}

{% block title %}Вход{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="/styles/login.css">
{% endblock %}

{% block body %}
<div>
    <h1>#MOCHILOVO-avi</h1>
    <form method="POST" action="{{ path('login_Proc') }}" enctype="multipart/form-data">
        <input type="text" name="nickName" value="{{ last_name }}" required placeholder="NickName">
        <input type="password" name="password" required placeholder="Password">
        <button type="submit">Играть</button>
        <a href="{{ path('registry') }}">Зарегаться</a>
    </form>
</div>
{% endblock %}
